{
  "name": "media-downloader",
  "version": "1.0.4",
  "private": true,
  "description": "A simple video/audio downloader.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
